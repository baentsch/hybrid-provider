# curl/nginx demo. Two configs, kept line-for-line alike so that
#     diff openssl-stock.cnf openssl.cnf
# shows the whole change: openssl-stock.cnf has oqsprovider serve its own
# hybrids, openssl.cnf has hybrid-provider serve them (see README.md).

openssl_conf = osslcfg

[osslcfg]
providers = prov_sect

[prov_sect]
default     = default_sect
hybrid      = pq_sect

[default_sect]
activate = 1

[pq_sect]
module   = /opt/pq/lib64/ossl-modules/hybrid.so
activate = 1
component-providers = default oqsprovider
component-path      = /opt/pq/lib64/ossl-modules
