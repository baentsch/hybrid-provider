# Out-of-tree build and local OpenSSL/liboqs scratch dirs. Globs so ad-hoc
# variants (build-401, build-asan-local, .local-401, .local-master-fresh, …)
# are covered too, not just the canonical names below.
build*/
.local*/
build/
build34/
build-master/
build-fuzz/
build-asan/
build-tsan/
.local/
.local-34/
.local-master/
openssl/
openssl-34/
oqs-provider/
liboqs/
.interop/
# Ignore everything under .claude/ (personal settings, local caches) except a
# deliberately-shared team settings.json, should one ever be committed.
.claude/*
!.claude/settings.json
